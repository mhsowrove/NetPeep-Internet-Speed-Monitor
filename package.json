{
  "name": "netpeep", "version": "2.0.0", "description": "A little window into your network", "author": "MD SOWROVE HOSSAIN", "license": "MIT",
  "main": "src/main.js",
  "scripts": {"start": "electron .", "test": "node --test", "pack": "electron-builder --dir", "dist:win": "electron-builder --win portable", "dist:mac": "electron-builder --mac dmg zip", "dist:mac:dev": "node scripts/build-mac.cjs", "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/icons.ps1"},
  "devDependencies": {"electron": "^42.0.0", "electron-builder": "^26.0.12"},
  "build": {"appId": "com.netpeep.desktop", "productName": "NetPeep", "asar": true, "files": ["src/**", "native/**", "assets/**", "package.json"], "asarUnpack": ["native/**"], "directories": {"output": "release"}, "win": {"icon": "assets/icon.ico", "target": "portable"}, "mac": {"icon": "assets/icon.png", "category": "public.app-category.utilities", "target": ["dmg", "zip"]}}
}
